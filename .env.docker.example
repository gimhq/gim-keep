# Runtime environment for the production docker-compose (lode) deploy of
# gim-keep at https://keep.g.im. Copy to `.env.docker` and fill in real values.
# This is the container's env (loaded via `env_file`); lode passes it through
# to the app and it wins over the [env] defaults in deploy/lode.toml
# (APP_NAME, APP_URL, CORS_ORIGIN, TRUST_PROXY, ...). Full list: `.env.example`.

# Public URL, only if it is not https://keep.g.im (must match the proxy route).
# APP_URL=https://keep.g.im
# CORS_ORIGIN=https://keep.g.im

# Forwarded client IPs are trusted (TRUST_PROXY=true in lode.toml): accept them
# only from the proxy network, and never publish the container port.
TRUSTED_PROXY_IPS=172.16.0.0/12

# Moderator login for the admin UI (report inbox). Pick one:
# a) OIDC provider. CLIENT_SECRET is optional when OAUTH_PKCE=true (default).
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# Bootstrap admin (email or username) granted admin on first login.
DEFAULT_ADMIN=
# b) a single local admin instead of OIDC (hash: `bun run hash-password`;
#    mount the file as a secret).
# SINGLE_USER_MODE=true
# SINGLE_USER_USERNAME=admin
# SINGLE_USER_PASSWORD_HASH_FILE=/run/secrets/gim_keep_admin_hash

# Encrypt the SQLite database at rest. Slots are already sealed by the
# clients; reports are plaintext. With encryption on, every restart (lode
# updates included) waits for an unlock unless MASTER_PASSWORD_FILE is set.
DB_ENCRYPTION=false

# Data location: app data anchors at `${LODE_DIR}/data` = /srv/lode/data
# automatically (a subdir of the lode volume, kept separate from lode's own
# state.json/versions/), so no DB_PATH / FILE_STORAGE_LOCAL_ROOT is needed.
# Set DATA_DIR to relocate it (e.g. a separate volume).
# DATA_DIR=/srv/lode/data
